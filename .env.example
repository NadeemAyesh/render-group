# Environment Variables for RenderLancer & Render Group Studio

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:password@localhost:5432/renderlancer?schema=public"

# Google Gemini API Key (for ATS Scoring & Bullet Point Enhancement)
GEMINI_API_KEY="AIzaSy..."

# NextAuth / Auth Secrets
NEXTAUTH_SECRET="renderlancer-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Cloudflare R2 Storage (for CV PDFs & User Portfolios)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="renderlancer-storage"
