// Prisma Schema for RenderLancer & Render Group Studio Ecosystem
// Database: PostgreSQL with pgvector support for AI Semantic Matching

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ==========================================
// 1. IDENTITY & AUTHENTICATION (SSO)
// ==========================================

enum UserRole {
  FREELANCER
  CLIENT
  DIASPORA_PARTNER
  ACADEMY_STUDENT
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED_PALESTINIAN_TALENT
  VERIFIED_DIASPORA_BUSINESS
  ENTERPRISE_VERIFIED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  fullName          String
  phone             String?
  avatarUrl         String?
  role              UserRole           @default(FREELANCER)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isDiaspora        Boolean            @default(false)
  currentCountry    String             @default("Palestine")
  city              String?
  preferredLanguage String             @default("ar") // 'ar' | 'en'
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relationships
  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?
  wallet            Wallet?
  resumes           Resume[]
  jobProposals      JobProposal[]
  postedJobs        Job[]
  contractsAsClient Contract[]         @relation("ClientContracts")
  contractsAsTalent Contract[]         @relation("TalentContracts")
  
  // Render Studio AI Subscriptions
  aiSubscription    UserSubscription?
  redeemedCodes     ActivationCode[]
  aiUsageLogs       AIToolUsageLog[]
  reviewsGiven      Review[]           @relation("ReviewsGiven")
  reviewsReceived   Review[]           @relation("ReviewsReceived")

  @@index([email])
  @@index([role])
}

// ==========================================
// 2. FREELANCER & CLIENT PROFILES
// ==========================================

model FreelancerProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline        String
  overview        String         @db.Text
  hourlyRate      Decimal        @db.Decimal(10, 2)
  yearsExperience Int            @default(1)
  rating          Decimal        @default(5.0) @db.Decimal(3, 2)
  reviewCount     Int            @default(0)
  totalEarned     Decimal        @default(0.0) @db.Decimal(12, 2)
  completedJobs   Int            @default(0)
  githubUrl       String?
  linkedinUrl     String?
  portfolioUrl    String?
  isAvailable     Boolean        @default(true)
  
  // AI Matching Vector Representation (1536 dims for text-embedding)
  profileEmbedding Unsupported("vector(1536)")?

  skills          FreelancerSkill[]
  portfolioItems  PortfolioItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ClientProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  companyWebsite String?
  industry       String?
  isDiasporaFirm Boolean        @default(false)
  country        String         @default("Palestine")
  totalSpent     Decimal        @default(0.0) @db.Decimal(12, 2)
  postedJobsCount Int           @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Skill {
  id          String            @id @default(uuid())
  name        String            @unique
  category    String
  freelancers FreelancerSkill[]
  jobSkills   JobSkill[]
  resumeSkills ResumeSkill[]
}

model FreelancerSkill {
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skillId             String
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level               Int               @default(3) // 1 to 5

  @@id([freelancerProfileId, skillId])
}

model PortfolioItem {
  id                  String            @id @default(uuid())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  title               String
  description         String            @db.Text
  coverImageUrl       String
  projectUrl          String?
  usedAITools         String[]          // e.g. ["Veo 3.1", "GPT Image 2", "Nano Banana Pro"]
  createdAt           DateTime          @default(now())
}

// ==========================================
// 3. AI-POWERED CV & RESUME STUDIO
// ==========================================

enum ResumeTemplate {
  EXECUTIVE_GOLD
  TECH_MINIMALIST
  ACADEMIC_FORMAL
  CREATIVE_STUDIO
}

model Resume {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String            // e.g. "Senior Full-Stack AI Resume"
  targetRole      String
  summary         String            @db.Text
  language        String            @default("ar") // 'ar' | 'en'
  template        ResumeTemplate    @default(EXECUTIVE_GOLD)
  atsScore        Int               @default(85)
  atsFeedback     Json?             // AI recommendations and improvement tips
  isPublic        Boolean           @default(false)
  publicSlug      String?           @unique
  pdfExportUrl    String?

  experiences     ResumeExperience[]
  educations      ResumeEducation[]
  projects        ResumeProject[]
  skills          ResumeSkill[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
}

model ResumeExperience {
  id                 String   @id @default(uuid())
  resumeId           String
  resume             Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company            String
  position           String
  location           String?
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean  @default(false)
  bulletsRaw         String[] // Original user statements
  bulletsAIEnhanced  String[] // Action verbs and metric-optimized bullets
}

model ResumeEducation {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String
  startDate   DateTime
  endDate     DateTime?
}

model ResumeProject {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  projectUrl  String?
  technologies String[]
}

model ResumeSkill {
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([resumeId, skillId])
}

// ==========================================
// 4. FREELANCE MARKETPLACE & JOBS
// ==========================================

enum JobStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BudgetType {
  FIXED
  HOURLY
}

model Job {
  id              String         @id @default(uuid())
  clientId        String
  client          User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  description     String         @db.Text
  category        String
  budgetType      BudgetType     @default(FIXED)
  budgetMin       Decimal        @db.Decimal(10, 2)
  budgetMax       Decimal        @db.Decimal(10, 2)
  status          JobStatus      @default(OPEN)
  isDiasporaSponsor Boolean      @default(false) // Sponsored by Palestinian diaspora business
  proposalsCount  Int            @default(0)

  // AI Matching Vector
  jobEmbedding    Unsupported("vector(1536)")?

  skillsRequired  JobSkill[]
  proposals       JobProposal[]
  contract        Contract?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([category])
}

model JobSkill {
  jobId   String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model JobProposal {
  id              String         @id @default(uuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId    String
  freelancer      User           @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  coverLetter     String         @db.Text
  proposedRate    Decimal        @db.Decimal(10, 2)
  estimatedDays   Int
  aiAssisted      Boolean        @default(false) // Generated or improved with Render AI
  aiMatchScore    Int?           // Calculated match percentage
  status          ProposalStatus @default(SUBMITTED)
  createdAt       DateTime       @default(now())

  @@unique([jobId, freelancerId])
}

// ==========================================
// 5. CONTRACTS, ESCROW & FINANCIAL RAILS
// ==========================================

enum ContractStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DISPUTED
}

model Contract {
  id            String         @id @default(uuid())
  jobId         String         @unique
  job           Job            @relation(fields: [jobId], references: [id])
  clientId      String
  client        User           @relation("ClientContracts", fields: [clientId], references: [id])
  talentId      String
  talent        User           @relation("TalentContracts", fields: [talentId], references: [id])
  totalAmount   Decimal        @db.Decimal(10, 2)
  escrowLocked  Decimal        @db.Decimal(10, 2)
  status        ContractStatus @default(ACTIVE)
  milestones    Milestone[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum MilestoneStatus {
  PENDING_FUNDING
  FUNDED_IN_ESCROW
  SUBMITTED_FOR_REVIEW
  APPROVED_PAID
  DISPUTED
}

model Milestone {
  id          String          @id @default(uuid())
  contractId  String
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  amount      Decimal         @db.Decimal(10, 2)
  status      MilestoneStatus @default(PENDING_FUNDING)
  dueDate     DateTime?
  completedAt DateTime?
}

// ==========================================
// 6. RENDER GROUP STUDIO - AI SUBSCRIPTION ENGINE
// ==========================================

enum SubscriptionPlan {
  FREE_TRIAL_24H
  STUDIO_CREATIVE_MONTHLY
  STUDIO_ENTERPRISE_YEARLY
  CUSTOM_PASS
}

enum SubscriptionStatus {
  TRIAL_ACTIVE
  ACTIVE
  EXPIRED
  CANCELLED
}

model UserSubscription {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan   @default(FREE_TRIAL_24H)
  status          SubscriptionStatus @default(TRIAL_ACTIVE)
  trialExpiresAt  DateTime?
  startedAt       DateTime           @default(now())
  expiresAt       DateTime?
  autoRenew       Boolean            @default(false)
  paidViaWallet   Boolean            @default(false)
  updatedAt       DateTime           @updatedAt
}

model ActivationCode {
  id              String           @id @default(uuid())
  code            String           @unique // e.g. "RENDER-GOLD-7X9Q"
  planGranted     SubscriptionPlan
  durationDays    Int              @default(30)
  maxRedemptions  Int              @default(1)
  timesRedeemed   Int              @default(0)
  isUsed          Boolean          @default(false)
  redeemedByUserId String?
  redeemedByUser   User?           @relation(fields: [redeemedByUserId], references: [id])
  redeemedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
}

model AITool {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g. "veo-3-1", "gpt-image-2", "nano-banana-pro"
  nameArabic  String   // "تعديل نانو بنانا برو"
  nameEnglish String   // "Nano Banana Pro"
  category    String   // "Video", "Image", "Avatar", "Productivity"
  icon        String   // Material icon symbol or SVG
  description String   @db.Text
  isPopular   Boolean  @default(false)
  isNew       Boolean  @default(false)
  dailyLimit  Int      @default(50) // Free tier daily calls
  active      Boolean  @default(true)
}

model AIToolUsageLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolSlug  String
  action    String   // e.g. "generate_video", "swap_face", "extract_prompt"
  creditsUsed Int    @default(1)
  createdAt DateTime @default(now())

  @@index([userId, toolSlug])
}

// ==========================================
// 7. WALLET & PALESTINE FINANCIAL RAILS
// ==========================================

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Decimal     @default(0.0) @db.Decimal(12, 2)
  pendingEscrow    Decimal     @default(0.0) @db.Decimal(12, 2)
  currency         String      @default("USD")
  transactions     Transaction[]
  payoutMethods    PayoutMethod[]
  updatedAt        DateTime    @updatedAt
}

enum TransactionType {
  JOB_PAYMENT_ESCROW_LOCKED
  JOB_PAYMENT_ESCROW_RELEASED
  AI_SUBSCRIPTION_PURCHASE // Paid using freelance balance!
  WALLET_DEPOSIT
  WALLET_WITHDRAWAL
  REFUND
}

model Transaction {
  id          String          @id @default(uuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  referenceId String?         // Contract ID, Activation Code ID, etc.
  createdAt   DateTime        @default(now())

  @@index([walletId])
}

enum PayoutChannel {
  PAYONEER
  USDT_CRYPTO_TRC20
  BANK_OF_PALESTINE
  PALPAY
  JAWWAL_PAY
  REFLECT_NEOBANK
}

model PayoutMethod {
  id          String        @id @default(uuid())
  walletId    String
  wallet      Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  channel     PayoutChannel
  accountIdentifier String  // Email, IBAN, or USDT Wallet Address
  isDefault   Boolean       @default(false)
  isVerified  Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

model Review {
  id         String   @id @default(uuid())
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  targetId   String
  target     User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating     Int      @default(5)
  feedback   String   @db.Text
  createdAt  DateTime @default(now())
}
